---
import { GISCUS_CONFIG, GISCUS_ENABLED } from '../giscus.config';

// giscus 自定义主题 CSS：一份，从 public/ 提供。
// 必须用绝对 URL（giscus 跨域 iframe 不支持相对路径）。
// 切换亮/暗通过 postMessage setConfig 传不同 URL 实现，
// 但必须等 iframe ready 后发送才生效——见下方 inline script。
const themeBase = Astro.site
  ? new URL('/giscus-', Astro.site).toString()
  : '/giscus-';
// 加版本 query 触发 giscus CDN 重新拉 CSS，避免缓存旧主题
const GISCUS_LIGHT_THEME = `${themeBase}light.css?v=4`;
const GISCUS_DARK_THEME = `${themeBase}dark.css?v=4`;
---

<section class="comments" aria-label="评论">
  <h2 class="comments__title">评论</h2>

  {
    GISCUS_ENABLED ? (
      <div
        class="comments__giscus"
        data-giscus
        data-light-theme={GISCUS_LIGHT_THEME}
        data-dark-theme={GISCUS_DARK_THEME}
      >
        <script
          src="https://giscus.app/client.js"
          data-repo={GISCUS_CONFIG.repo}
          data-repo-id={GISCUS_CONFIG.repoId}
          data-category={GISCUS_CONFIG.category}
          data-category-id={GISCUS_CONFIG.categoryId}
          data-mapping={GISCUS_CONFIG.mapping}
          data-strict="0"
          data-reactions-enabled={GISCUS_CONFIG.reactionsEnabled}
          data-emit-metadata={GISCUS_CONFIG.emitMetadata}
          data-input-position={GISCUS_CONFIG.inputPosition}
          data-theme={GISCUS_DARK_THEME}
          data-lang={GISCUS_CONFIG.lang}
          crossorigin="anonymous"
          async
        />
      </div>
    ) : (
      <p class="comments__hint text-soft">
        评论系统尚未配置。在
        <code>src/giscus.config.ts</code>
        填入仓库信息后即可启用（详见文件内注释）。
      </p>
    )
  }
</section>

<script is:inline>
  (function () {
    const root = document.documentElement;
    const host = document.querySelector('[data-giscus]');
    if (!host) return;
    const LIGHT = host.getAttribute('data-light-theme');
    const DARK = host.getAttribute('data-dark-theme');
    const currentTheme = () =>
      root.getAttribute('data-theme') === 'dark' ? DARK : LIGHT;

    // 首次加载用静态 URL（带 ?v=N），让 CDN 缓存生效。
    const slot = host.querySelector('script');
    if (slot) {
      slot.setAttribute('data-theme', currentTheme());
    }

    let iframeReady = false;

    // giscus 已知问题 (#1316): setConfig 传 URL theme 不会触发 CSS 重新加载。
    // 解决：每次切换时给 URL 加时间戳 cache-bust，强制 giscus 当成新 URL 处理。
    const bust = (url) => `${url}&t=${Date.now()}`;

    const sendTheme = (theme) => {
      const iframe = host.querySelector('iframe.giscus-frame');
      if (!iframe || !iframe.contentWindow) return;
      iframe.contentWindow.postMessage(
        { giscus: { setConfig: { theme } } },
        'https://giscus.app',
      );
    };

    window.addEventListener('message', (e) => {
      if (e.origin !== 'https://giscus.app') return;
      if (e.data?.giscus?.ready) {
        iframeReady = true;
        // ready 后同步一次当前主题（用原始 URL，首次加载无需 bust）
        sendTheme(currentTheme());
      }
    });

    // 切主题时：用带时间戳的 URL 强制 giscus 重新加载 CSS
    window.addEventListener('themechange', (e) => {
      if (!iframeReady) return;
      const next = e.detail === 'dark' ? DARK : LIGHT;
      sendTheme(bust(next));
    });
  })();
</script>

<style>
  .comments {
    margin-top: var(--space-5);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .comments__title {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-soft);
    margin: 0 0 var(--space-2);
  }

  .comments__hint {
    font-size: 0.9rem;
  }

  .comments__giscus :global(.giscus) {
    max-width: 100%;
  }

  .comments__giscus :global(.giscus-frame) {
    width: 100%;
    border: none;
  }

  .comments__giscus :global(.giscus-loading) {
    opacity: 0.4;
  }
</style>
