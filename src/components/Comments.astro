---
import { GISCUS_CONFIG, GISCUS_ENABLED } from '../giscus.config';

// giscus 自定义主题 CSS：一份，从 public/ 提供。
// 必须用绝对 URL（giscus 跨域 iframe 不支持相对路径）。
const themeBase = Astro.site
  ? new URL('/giscus-', Astro.site).toString()
  : '/giscus-';
// 加版本 query 触发 giscus CDN 重新拉 CSS，避免缓存旧主题
const GISCUS_LIGHT_THEME = `${themeBase}light.css?v=4`;
const GISCUS_DARK_THEME = `${themeBase}dark.css?v=4`;
---

<section class="comments" aria-label="评论">
  <h2 class="comments__title">评论</h2>

  {
    GISCUS_ENABLED ? (
      <div
        class="comments__giscus"
        data-giscus
        data-light-theme={GISCUS_LIGHT_THEME}
        data-dark-theme={GISCUS_DARK_THEME}
        data-repo={GISCUS_CONFIG.repo}
        data-repo-id={GISCUS_CONFIG.repoId}
        data-category={GISCUS_CONFIG.category}
        data-category-id={GISCUS_CONFIG.categoryId}
        data-mapping={GISCUS_CONFIG.mapping}
        data-reactions-enabled={GISCUS_CONFIG.reactionsEnabled}
        data-emit-metadata={GISCUS_CONFIG.emitMetadata}
        data-input-position={GISCUS_CONFIG.inputPosition}
        data-lang={GISCUS_CONFIG.lang}
      >
        {/* giscus 脚本由下方逻辑在滚到视口时动态注入，
            避免一进页面就加载 iframe 和发起 GitHub API 请求 */}
        <noscript>
          <p class="comments__hint text-soft">
            需要 JavaScript 才能查看评论。
          </p>
        </noscript>
        <p class="comments__placeholder text-faint">评论加载中…</p>
      </div>
    ) : (
      <p class="comments__hint text-soft">
        评论系统尚未配置。在
        <code>src/giscus.config.ts</code>
        填入仓库信息后即可启用（详见文件内注释）。
      </p>
    )
  }
</section>

<script>
  function buildGiscusScript(host, theme) {
    const cfg = host.dataset;
    const s = document.createElement('script');
    s.src = 'https://giscus.app/client.js';
    s.setAttribute('data-repo', cfg.repo);
    s.setAttribute('data-repo-id', cfg.repoId);
    s.setAttribute('data-category', cfg.category);
    s.setAttribute('data-category-id', cfg.categoryId);
    s.setAttribute('data-mapping', cfg.mapping);
    s.setAttribute('data-strict', '0');
    s.setAttribute('data-reactions-enabled', cfg.reactionsEnabled);
    s.setAttribute('data-emit-metadata', cfg.emitMetadata);
    s.setAttribute('data-input-position', cfg.inputPosition);
    s.setAttribute('data-theme', theme);
    s.setAttribute('data-lang', cfg.lang);
    s.crossOrigin = 'anonymous';
    s.async = true;
    return s;
  }

  function setupComments() {
    const root = document.documentElement;
    const host = document.querySelector('[data-giscus]');
    if (!host) return;
    if (host.dataset.bound) return;
    host.dataset.bound = '1';

    const LIGHT = host.getAttribute('data-light-theme');
    const DARK = host.getAttribute('data-dark-theme');
    const currentTheme = () =>
      root.getAttribute('data-theme') === 'dark' ? DARK : LIGHT;

    let loaded = false;
    const load = (theme) => {
      if (loaded) return;
      loaded = true;
      const placeholder = host.querySelector('.comments__placeholder');
      if (placeholder) placeholder.remove();
      host.appendChild(buildGiscusScript(host, theme));
    };

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              load(currentTheme());
              io.disconnect();
              break;
            }
          }
        },
        { rootMargin: '300px 0px' },
      );
      io.observe(host);
    } else {
      load(currentTheme());
    }

    // 切主题时重建（首次加载后才有意义）
    host._rebuildGiscus = (theme) => {
      if (!loaded) return;
      host.innerHTML = '';
      host.appendChild(buildGiscusScript(host, theme));
    };
  }

  // 全局 themechange 监听器：只绑一次，转发给当前 host
  if (!window.__giscusThemeBound) {
    window.__giscusThemeBound = true;
    window.addEventListener('themechange', (e) => {
      const host = document.querySelector('[data-giscus]');
      if (!host || !host._rebuildGiscus) return;
      const LIGHT = host.getAttribute('data-light-theme');
      const DARK = host.getAttribute('data-dark-theme');
      host._rebuildGiscus(e.detail === 'dark' ? DARK : LIGHT);
    });
  }

  setupComments();
  document.addEventListener('astro:page-load', setupComments);
</script>

<style>
  .comments {
    margin-top: var(--space-5);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .comments__title {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-soft);
    margin: 0 0 var(--space-2);
  }

  .comments__hint,
  .comments__placeholder {
    font-size: 0.9rem;
  }

  .comments__giscus :global(.giscus) {
    max-width: 100%;
  }

  .comments__giscus :global(.giscus-frame) {
    width: 100%;
    border: none;
  }

  .comments__giscus :global(.giscus-loading) {
    opacity: 0.4;
  }
</style>
