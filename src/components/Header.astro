---
import { SITE_TITLE, NAV_LINKS } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="container-wide site-header__inner">
    <a href="/" class="site-header__brand">{SITE_TITLE}</a>
    <div class="site-header__right">
      <nav class="site-header__nav">
        {
          NAV_LINKS.map((link) => (
            <a
              href={link.href}
              class:list={['site-header__link', { 'is-active': isActive(link.href) }]}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  /* 墨迹洇开：header 下方极淡的阴影扩散，像墨水在纸纤维里微微渗透 */
  .site-header::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 6px;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-text-soft) 4%, transparent),
      transparent
    );
    pointer-events: none;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    padding-bottom: 1rem;
  }

  .site-header__brand {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .site-header__brand:hover {
    color: var(--color-accent);
  }

  .site-header__right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .site-header__nav {
    display: flex;
    gap: 1.5rem;
  }

  .site-header__link {
    font-family: var(--font-sans);
    font-size: 0.92rem;
    color: var(--color-text-soft);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .site-header__link:hover,
  .site-header__link.is-active {
    color: var(--color-text);
  }

  @media (max-width: 480px) {
    .site-header__inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
    .site-header__right {
      width: 100%;
      justify-content: space-between;
    }
    .site-header__nav {
      gap: 1.2rem;
    }
  }
</style>
