---
import { SITE_TITLE } from '../consts';
const now = new Date();
const year = now.getFullYear();
const month = now.getMonth() + 1;
const day = now.getDate();
// 凌晨 / 上午 / 下午 / 深夜
const hour = now.getHours();
const period = hour < 6 ? '深夜' : hour < 12 ? '上午' : hour < 18 ? '下午' : '深夜';
const stamp = `${year}.${String(month).padStart(2, '0')}.${String(day).padStart(2, '0')} · ${period}`;
---

<footer class="site-footer">
  <div class="container-wide site-footer__inner">
    <!-- 左：手写签 -->
    <span class="site-footer__sig">{SITE_TITLE}</span>

    <!-- 中：手稿日期戳 -->
    <span class="site-footer__stamp">
      <span class="site-footer__stamp-line"></span>
      记于 {stamp}
    </span>

    <!-- 右：页码 -->
    <span class="site-footer__page">
      <span class="site-footer__folio" aria-hidden="true">№</span>
      <span class="site-footer__credits">Astro</span>
    </span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-3);
    padding: var(--space-2) 0 var(--space-3);
    position: relative;
  }

  
  .site-footer__inner {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    color: var(--color-text-faint);
  }

  /* 手写签 */
  .site-footer__sig {
    font-family: 'Caveat', 'Segoe Script', cursive;
    font-size: 1.25rem;
    color: var(--color-text-soft);
    line-height: 1;
    position: relative;
  }

  /* 签名下极淡的墨迹拖尾——钢笔快速书写时留下的渐淡线 */
  .site-footer__sig::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 100%;
    margin-left: 1px;
    width: 18px;
    height: 0.5px;
    background: linear-gradient(to right, var(--color-text-faint), transparent);
  }

  /* 日期戳 */
  .site-footer__stamp {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--color-text-faint);
  }

  /* 手写日期旁的横线：像实验记录本上先画线再填日期 */
  .site-footer__stamp-line {
    display: inline-block;
    width: 2rem;
    height: 0;
    border-top: 0.5px solid var(--color-text-faint);
    opacity: 0.5;
  }

  /* 页码 / 尾注 */
  .site-footer__page {
    display: flex;
    align-items: baseline;
    gap: 0.15rem;
    font-size: 0.7rem;
  }

  .site-footer__folio {
    font-family: var(--font-serif);
    font-style: italic;
    opacity: 0.4;
  }

  .site-footer__credits {
    opacity: 0.4;
  }

  @media (max-width: 480px) {
    .site-footer__inner {
      flex-direction: column;
      align-items: center;
      gap: 0.4rem;
    }
    .site-footer__stamp {
      order: 3;
    }
    .site-footer__page {
      order: 2;
    }
  }
</style>
