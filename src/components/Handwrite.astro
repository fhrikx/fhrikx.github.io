---
export interface Props {
  text: string;
  class?: string;
  delay?: number;
  as?: 'span' | 'h1' | 'h2' | 'p';
}

const { text, class: className, delay = 400, as: Tag = 'span' } = Astro.props;

const narrow = new Set(['i','l','t','f','r','j','\'','.',',',' ','I','L','T','F','J']);
const wide = new Set(['m','w','M','W']);
let dashLen = 0;
for (const ch of text) {
  if (wide.has(ch)) dashLen += 65;
  else if (narrow.has(ch)) dashLen += 35;
  else dashLen += 50;
}
const vw = Math.max(120, text.length * 30 + 16);
---

<Tag
  class:list={['handwrite', className]}
  style={`--hw-dash: ${dashLen}; --hw-delay: ${delay}ms`}
  aria-label={text}
>
  <svg
    viewBox={`0 0 ${vw} 66`}
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    class="handwrite__svg"
  >
    <!-- 描边层：stroke-dashoffset 动画模拟笔顺 -->
    <text
      x="2"
      y="52"
      class="handwrite__ink"
      stroke-dasharray={dashLen}
      stroke-dashoffset={dashLen}
    >{text}</text>
    <!-- 填充层：描边完成后淡入，盖掉描边的轮廓感 -->
    <text
      x="2"
      y="52"
      class="handwrite__fill"
    >{text}</text>
  </svg>
  <!-- 笔尖 -->
  <span class="handwrite__nib" aria-hidden="true"></span>
</Tag>

<style>
  .handwrite {
    display: block;
    position: relative;
    line-height: 1.2;
  }

  .handwrite__svg {
    display: block;
    width: 100%;
    max-width: 320px;
    height: auto;
    overflow: visible;
  }

  .handwrite__ink {
    font-family: 'Caveat', 'Segoe Script', cursive;
    font-size: 48px;
    font-weight: 500;
    letter-spacing: 1px;
    fill: none;
    stroke: var(--color-text);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    animation: hw-draw 2s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    animation-delay: var(--hw-delay, 400ms);
  }

  .handwrite__fill {
    font-family: 'Caveat', 'Segoe Script', cursive;
    font-size: 48px;
    font-weight: 500;
    letter-spacing: 1px;
    fill: var(--color-text);
    opacity: 0;
    animation: hw-fill 0.3s ease forwards;
    animation-delay: calc(var(--hw-delay, 400ms) + 2s + 100ms);
  }

  .handwrite__nib {
    position: absolute;
    top: 50%;
    width: 6px;
    height: 1.3em;
    transform: translateY(-55%) translateX(-50%);
    pointer-events: none;
    opacity: 0;
    animation: hw-nib-travel 2s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    animation-delay: var(--hw-delay, 400ms);
  }

  .handwrite__nib::before {
    content: '';
    display: block;
    width: 100%;
    height: 100%;
    background: radial-gradient(
      ellipse 3px 60% at 50% 50%,
      var(--color-text) 0%,
      color-mix(in srgb, var(--color-accent) 20%, transparent) 35%,
      transparent 70%
    );
    border-radius: 50%;
  }

  @keyframes hw-draw {
    to { stroke-dashoffset: 0; }
  }

  @keyframes hw-fill {
    to { opacity: 1; }
  }

  @keyframes hw-nib-travel {
    0%   { left: 0%;   opacity: 0.8; }
    7%   { left: 7%;   opacity: 0.75; }
    15%  { left: 15%;  opacity: 0.8; }
    22%  { left: 22%;  opacity: 0.7; }
    30%  { left: 30%;  opacity: 0.75; }
    38%  { left: 38%;  opacity: 0.7; }
    46%  { left: 46%;  opacity: 0.75; }
    54%  { left: 54%;  opacity: 0.7; }
    62%  { left: 62%;  opacity: 0.7; }
    70%  { left: 70%;  opacity: 0.65; }
    78%  { left: 78%;  opacity: 0.6; }
    86%  { left: 86%;  opacity: 0.5; }
    94%  { left: 94%;  opacity: 0.4; }
    100% { left: 100%; opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .handwrite__ink { display: none; }
    .handwrite__fill { opacity: 1; animation: none; }
    .handwrite__nib { display: none; }
  }
</style>