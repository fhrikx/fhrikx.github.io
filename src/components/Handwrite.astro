---
export interface Props {
  delay?: number;
  class?: string;
}

const { delay = 400, class: className } = Astro.props;
---

<svg
  class:list={['handwrite', className]}
  viewBox="0 0 460 82"
  xmlns="http://www.w3.org/2000/svg"
  aria-label="FHR's Blog"
  role="img"
>
  <text x="4" y="65" class="hw-stroke" stroke-dasharray="1000" stroke-dashoffset="1000">
    FHR's Blog
  </text>
  <text x="4" y="65" class="hw-fill">FHR's Blog</text>
</svg>

<style is:global>
  .hw-stroke {
    font-family: 'Caveat', 'Segoe Script', cursive;
    font-size: 58px;
    font-weight: 500;
    fill: none;
    stroke: var(--color-text, #1a1814);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    animation: hw-draw 1.4s 0.4s ease-in forwards,
               hw-drop 0s 1.8s forwards;
  }

  .hw-fill {
    font-family: 'Caveat', 'Segoe Script', cursive;
    font-size: 58px;
    font-weight: 500;
    fill: var(--color-text, #1a1814);
    opacity: 0;
    animation: hw-land 0s 1.8s forwards;
  }

  @keyframes hw-draw   { to { stroke-dashoffset: 0; } }
  @keyframes hw-drop   { to { stroke: transparent; } }
  @keyframes hw-land   { to { opacity: 1; } }

  @media (prefers-reduced-motion: reduce) {
    .hw-stroke { display: none; }
    .hw-fill   { opacity: 1; animation: none; }
  }
</style>

<style>
  .handwrite {
    display: block; width: 100%; max-width: 370px;
    height: auto; overflow: visible;
  }
  @media (max-width: 640px) { .handwrite { max-width: 280px; } }
</style>

<script>
  function measure(svg: SVGSVGElement) {
    const text = svg.querySelector('.hw-stroke') as SVGTextElement;
    if (!text) return;
    const len = Math.ceil(text.getComputedTextLength() * 2.8);
    text.setAttribute('stroke-dasharray', String(len));
    text.setAttribute('stroke-dashoffset', String(len));
  }
  function run() {
    document.querySelectorAll('.handwrite svg').forEach((s) => measure(s as SVGSVGElement));
  }
  if (document.fonts) { document.fonts.ready.then(run); }
  else { setTimeout(run, 600); }
  document.addEventListener('astro:page-load', () => {
    if (document.fonts) { document.fonts.ready.then(run); }
    else { setTimeout(run, 600); }
  });
</script>