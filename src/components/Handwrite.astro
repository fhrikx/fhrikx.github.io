---
export interface Props {
  text: string;
  class?: string;
  delay?: number;
  as?: 'span' | 'h1' | 'h2' | 'p';
}

const { text, class: className, delay = 400, as: Tag = 'span' } = Astro.props;
---

<Tag class:list={['handwrite', className]} aria-label={text}>
  <canvas class="handwrite__canvas" aria-hidden="true"></canvas>
  <span class="handwrite__fallback">{text}</span>
</Tag>

<style>
  .handwrite { display: block; position: relative; line-height: 1.2; }
  .handwrite__canvas { display: block; width: 100%; max-width: 440px; height: auto; }
  .handwrite__fallback {
    font-family: 'Caveat', 'Segoe Script', cursive;
    font-size: 2.2rem; font-weight: 500; color: var(--color-text);
  }
  .js .handwrite__fallback { display: none; }
  .no-js .handwrite__canvas { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .handwrite__canvas { display: none; }
    .handwrite__fallback { display: block !important; }
  }
</style>

<script>
  // ── 手写动画引擎 ──────────────────────────────────
  // 策略：每个字母从它的连笔入口点（基线左侧）开始，
  // 像素按离入口的欧氏距离排序揭示，自然沿字形蔓延。

  interface Glyph {
    ch: string;
    x0: number; x1: number;
    entry: { x: number; y: number }; // 连笔入口
    pixels: { x: number; y: number; dist: number }[];
  }

  function init(canvas: HTMLCanvasElement) {
    const label = canvas.closest('.handwrite')?.getAttribute('aria-label') ?? '';
    if (!label || (canvas as any).__hwInit) return;
    (canvas as any).__hwInit = true;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const dpr = Math.min(devicePixelRatio || 1, 2);
    const W = 720, H = 130;
    canvas.width = W * dpr; canvas.height = H * dpr;
    canvas.style.maxWidth = '440px';

    const ctx = canvas.getContext('2d')!;
    ctx.scale(dpr, dpr);
    const style = getComputedStyle(document.documentElement);
    const ink = style.getPropertyValue('--color-text').trim() || '#1a1814';

    const FONT = "500 56px 'Caveat', 'Segoe Script', cursive";
    ctx.font = FONT;
    ctx.textBaseline = 'alphabetic';

    // ── 步骤 1: 测量每个字母的 X 范围 ──
    const chars = [...label];
    const xStart: number[] = [4];
    for (const ch of chars) xStart.push(xStart[xStart.length - 1] + ctx.measureText(ch).width);

    // ── 步骤 2: 渲染完整文字到离屏 canvas,提取像素 ──
    const off = document.createElement('canvas');
    off.width = W; off.height = H;
    const octx = off.getContext('2d')!;
    octx.font = FONT;
    octx.textBaseline = 'alphabetic';
    octx.fillStyle = '#000';
    octx.fillText(label, 4, 72);
    const img = octx.getImageData(0, 0, W, H);

    // 扫描所有墨迹像素
    const inkSet = new Set<number>();
    for (let y = 0; y < H; y++)
      for (let x = 0; x < W; x++)
        if (img.data[(y * W + x) * 4 + 3] > 50)
          inkSet.add(y * W + x);

    // ── 步骤 3: 为每个字母构建字形数据 ──
    const glyphs: Glyph[] = [];
    let globalPixels: { x: number; y: number }[] = [];

    for (let i = 0; i < chars.length; i++) {
      const x0 = Math.floor(xStart[i]);
      const x1 = Math.ceil(xStart[i + 1]) + 1;

      // 找该字母的墨迹像素
      const pixels: { x: number; y: number }[] = [];
      for (let x = x0; x <= x1; x++)
        for (let y = 0; y < H; y++)
          if (inkSet.has(y * W + x))
            pixels.push({ x, y });

      if (pixels.length === 0) continue;

      // 连笔入口：基线附近最左的墨迹像素
      const baselineY = 70;
      let entry = pixels[0];
      let bestDist = Infinity;
      for (const p of pixels) {
        const d = Math.abs(p.y - baselineY) * 1.2 + (p.x - x0);
        if (d < bestDist) { bestDist = d; entry = p; }
      }

      // 计算每个像素到入口的欧氏距离
      const withDist = pixels.map(p => ({
        ...p,
        dist: Math.hypot(p.x - entry.x, (p.y - entry.y) * 1.3) // Y 方向稍加权重模拟书写方向
      }));

      // 按距离排序：入口最近的先出现
      withDist.sort((a, b) => a.dist - b.dist);

      glyphs.push({ ch: chars[i], x0, x1, entry, pixels: withDist });

      // 添加到全局序列，字母间留缝隙（提笔）
      for (const p of withDist) globalPixels.push({ x: p.x, y: p.y });
      // 提笔过渡：加几个重复像素，让笔尖停在原地短暂停留
      if (withDist.length > 0) {
        const last = withDist[withDist.length - 1];
        for (let k = 0; k < 3; k++) globalPixels.push({ x: last.x, y: last.y });
      }
    }

    if (globalPixels.length === 0) return;

    // ── 步骤 4: 动画 ──
    const DURATION = 2600;
    const PX_PER_MS = globalPixels.length / DURATION;
    const START_DELAY = 400;

    ctx.fillStyle = ink;
    let drawn = 0;
    let startT = 0;
    let started = false;

    function frame(now: number) {
      if (!started) { startT = now; started = true; requestAnimationFrame(frame); return; }
      const elapsed = now - startT;
      if (elapsed < START_DELAY) { requestAnimationFrame(frame); return; }

      const target = Math.floor((elapsed - START_DELAY) * PX_PER_MS);

      if (target > drawn) {
        const batch = Math.min(target - drawn, 30);
        for (let i = drawn; i < drawn + batch && i < globalPixels.length; i++) {
          ctx.fillRect(globalPixels[i].x, globalPixels[i].y, 1.3, 1.3);
        }
        drawn += batch;
      }

      if (drawn >= globalPixels.length) {
        // 最终干净重绘
        ctx.clearRect(0, 0, W, H);
        ctx.fillText(label, 4, 72);
        return;
      }

      requestAnimationFrame(frame);
    }

    requestAnimationFrame(frame);
  }

  function setup() {
    document.querySelectorAll('.handwrite__canvas').forEach((c) => init(c as HTMLCanvasElement));
  }
  if (document.fonts) document.fonts.ready.then(setup);
  else setTimeout(setup, 800);
  document.addEventListener('astro:page-load', () => {
    if (document.fonts) document.fonts.ready.then(setup);
    else setTimeout(setup, 800);
  });
</script>