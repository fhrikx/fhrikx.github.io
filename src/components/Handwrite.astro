---
export interface Props {
  delay?: number;
  class?: string;
}

const { delay = 400, class: className } = Astro.props;
---

<svg
  class:list={['handwrite', className]}
  viewBox="0 0 440 76"
  xmlns="http://www.w3.org/2000/svg"
  aria-label="FHR's Blog"
  role="img"
  style={`--hw-delay: ${delay}ms`}
>
  <!-- 描边：stroke-dashoffset 沿真实字形轮廓画出 -->
  <text
    x="4" y="63"
    class="hw-stroke"
    stroke-dasharray="800"
    stroke-dashoffset="800"
  >FHR's Blog</text>
  <!-- 填充：描边结束后淡入 -->
  <text
    x="4" y="63"
    class="hw-fill"
  >FHR's Blog</text>
</svg>

<style is:global>
  .hw-stroke {
    font-family: 'Caveat', 'Segoe Script', cursive;
    font-size: 58px;
    font-weight: 500;
    fill: none;
    stroke: var(--color-text, #1a1814);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    animation:
      hw-draw 2.6s cubic-bezier(0.3,0,0.3,1) forwards,
      hw-stroke-out 0.15s ease 2.6s forwards;
    animation-delay: var(--hw-delay, 400ms), calc(var(--hw-delay, 400ms) + 2.6s);
  }

  .hw-fill {
    font-family: 'Caveat', 'Segoe Script', cursive;
    font-size: 58px;
    font-weight: 500;
    fill: var(--color-text, #1a1814);
    opacity: 0;
    animation: hw-fill-in 0.15s ease 2.6s forwards;
    animation-delay: calc(var(--hw-delay, 400ms) + 2.6s);
  }

  @keyframes hw-draw {
    to { stroke-dashoffset: 0; }
  }
  @keyframes hw-stroke-out {
    to { opacity: 0; }
  }
  @keyframes hw-fill-in {
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hw-stroke { display: none; }
    .hw-fill { opacity: 1; animation: none; }
  }
</style>

<style>
  .handwrite {
    display: block;
    width: 100%;
    max-width: 370px;
    height: auto;
    overflow: visible;
  }

  @media (max-width: 640px) {
    .handwrite {
      max-width: 280px;
    }
  }
</style>