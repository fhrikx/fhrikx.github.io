---
// 手写 SVG 路径 — FHR's Blog
// 每个字母一条 SVG <path>，stroke-dashoffset 动画模拟一笔一划写出

export interface Props {
  delay?: number;
  class?: string;
}

const { delay = 400, class: className } = Astro.props;

// 每个字母的 SVG 路径和时长（ms）
interface LetterPath {
  label: string;    // 实际显示字符
  d: string;        // SVG path data
  dur: number;      // 动画时长 ms
}

const letters: LetterPath[] = [
  // F — 竖笔向下 → 提笔到顶 → 横笔向右
  {
    label: 'F',
    d: 'M 12,68 C 11,60 11,52 11,42 L 11,12 M 11,12 C 13,8 14,7 16,6 M 16,6 L 42,8 M 11,38 L 34,38',
    dur: 520,
  },
  // H — 左竖 → 横 → 右竖
  {
    label: 'H',
    d: 'M 8,68 L 8,12 M 8,38 L 42,38 M 42,68 L 42,12',
    dur: 480,
  },
  // R — 竖 → 顶部弧 → 斜腿
  {
    label: 'R',
    d: 'M 8,68 L 8,14 C 8,8 10,6 14,6 L 32,6 C 43,6 44,24 36,30 L 28,34 M 34,42 L 46,68',
    dur: 560,
  },
  // ' — 撇号
  {
    label: "'",
    d: 'M 10,6 C 9,10 10,14 12,16',
    dur: 180,
  },
  // s — 草书 s：从基线起笔 → 弧线向左下 → 转右上
  {
    label: 's',
    d: 'M 36,58 C 34,54 32,58 30,62 C 27,70 25,66 24,62 C 22,56 28,50 38,48 C 48,46 46,40 36,42 C 28,44 24,52 24,56',
    dur: 500,
  },
  // 空格
  {
    label: ' ',
    d: '',
    dur: 200,
  },
  // B — 竖 → 上弧 → 下弧
  {
    label: 'B',
    d: 'M 8,68 L 8,12 M 8,12 C 8,6 12,6 16,6 L 28,6 C 42,6 44,24 32,28 C 44,32 46,50 32,52 L 12,54 C 9,56 8,58 8,64 L 8,68',
    dur: 580,
  },
  // l — 竖向上弧
  {
    label: 'l',
    d: 'M 8,68 C 8,50 8,34 8,20 C 9,8 14,4 20,6',
    dur: 300,
  },
  // o — 椭圆
  {
    label: 'o',
    d: 'M 24,56 C 24,66 30,68 36,62 C 44,56 44,44 36,40 C 28,36 24,44 24,56 Z',
    dur: 400,
  },
  // g — 圆 → 下勾
  {
    label: 'g',
    d: 'M 36,38 C 44,34 52,40 48,48 C 44,56 36,46 28,46 C 18,46 14,54 16,64 C 18,72 24,78 30,74 C 36,70 34,62 34,60',
    dur: 560,
  },
];

// 累计时长
let acc = 0;
const timing = letters.map((l) => {
  const s = acc;
  acc += l.dur;
  return { ...l, start: s };
});
const totalDur = acc;

// viewBox
const vbW = 420;
const vbH = 96;
---

<svg
  class:list={['handwrite', className]}
  viewBox={`0 0 ${vbW} ${vbH}`}
  xmlns="http://www.w3.org/2000/svg"
  aria-label="FHR's Blog"
  role="img"
  style={`--hw-delay: ${delay}ms; --hw-total: ${totalDur}ms`}
>
  <defs>
    {/* 笔触效果：stroke 渐变，模拟钢笔墨迹 */}
    <style>
      .hw-path {
        fill: none;
        stroke: var(--color-text, #1a1814);
        stroke-width: 3;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-dasharray: 600;
        stroke-dashoffset: 600;
        animation:
          hw-draw var(--hw-dur) cubic-bezier(0.35, 0, 0.25, 1) forwards,
          hw-ink 0.3s ease forwards;
        animation-delay: var(--hw-start), var(--hw-start);
      }
      @keyframes hw-draw {
        to { stroke-dashoffset: 0; }
      }
      /* 写完的字母：淡入填充盖掉 stroke，变成实心字 */
      @keyframes hw-ink {
        0%, 95% { fill: transparent; }
        100% { fill: var(--color-text, #1a1814); stroke: none; }
      }

      @media (prefers-reduced-motion: reduce) {
        .hw-path {
          animation: none;
          stroke-dashoffset: 0;
          fill: var(--color-text, #1a1814);
          stroke: none;
        }
      }
    </style>
  </defs>

  {letters.map((l, i) => {
    if (!l.d) return null;
    const dur = (l.dur / 1000).toFixed(2) + 's';
    const start = ((delay + timing[i].start) / 1000).toFixed(2) + 's';
    return (
      <path
        class="hw-path"
        d={l.d}
        style={`--hw-dur: ${dur}; --hw-start: ${start}`}
      />
    );
  })}
</svg>

<style>
  .handwrite {
    display: block;
    width: 100%;
    max-width: 340px;
    height: auto;
    overflow: visible;
  }
</style>