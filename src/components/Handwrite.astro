---
export interface Props {
  text: string;
  class?: string;
  delay?: number;
  as?: 'span' | 'h1' | 'h2' | 'p';
}

const { text, class: className, delay = 400, as: Tag = 'span' } = Astro.props;

// 每个字母的手写时长（ms）：基于复杂度
const speeds: Record<string, number> = {
  i: 140, l: 140, t: 150, f: 170, r: 160, j: 150,
  a: 190, c: 180, e: 200, n: 200, o: 210, s: 180, u: 190, v: 180, x: 210, z: 190,
  b: 220, d: 230, g: 240, h: 220, k: 210, p: 240, q: 240, y: 220,
  m: 280, w: 280,
  "'": 90, '.': 80, ' ': 100,
  'B': 260, 'F': 260, 'H': 270, 'R': 260, 'S': 250,
};
const chars = [...text];
let acc = 0;
const timing = chars.map((ch) => {
  const dur = speeds[ch] ?? 200;
  const s = acc;
  acc += dur;
  return { ch, dur, start: s };
});
const total = acc;
---

<Tag
  class:list={['handwrite', className]}
  aria-label={text}
>
  <span class="handwrite__word" aria-hidden="true" style={`--hw-delay: ${delay}ms; --hw-total: ${total}ms`}>
    {chars.map((ch, i) => (
      <span
        class="handwrite__letter"
        style={`--l-delay: ${timing[i].start}ms; --l-dur: ${timing[i].dur}ms`}
        data-char={ch}
      >
        <span class="handwrite__ink">{ch}</span>
        {/* 笔尖 */}
        <span class="handwrite__dot" aria-hidden="true"></span>
      </span>
    ))}
  </span>
  <span class="handwrite__fallback">{text}</span>
</Tag>

<style>
  .handwrite {
    display: block;
    position: relative;
    line-height: 1.3;
    min-height: 1.2em;
  }

  .handwrite__word {
    display: inline-flex;
    font-family: 'Caveat', 'Segoe Script', cursive;
    font-size: 2.2rem;
    font-weight: 500;
    color: var(--color-text);
  }

  .handwrite__fallback {
    font-family: 'Caveat', 'Segoe Script', cursive;
    font-size: 2.2rem; font-weight: 500; color: var(--color-text);
  }
  .js .handwrite__fallback { display: none; }
  .no-js .handwrite__word { display: none; }

  /* 每个字母 */
  .handwrite__letter {
    position: relative;
    display: inline-block;
    white-space: pre;
  }

  /* 墨迹层：clip-path 对角线揭示，模拟钢笔 45° 斜角写出字形 */
  .handwrite__ink {
    display: inline-block;
    /* 从右下角 45° 斜线切到左上角 — 模拟右撇子钢笔写出时起笔,收笔方向 */
    clip-path: polygon(100% 100%, 100% 100%, 0% 100%, 0% 100%);
    animation: hw-write var(--l-dur, 200ms) cubic-bezier(0.33, 0, 0.2, 1) forwards;
    animation-delay: calc(var(--hw-delay, 400ms) + var(--l-delay, 0ms));
    /* 书写时墨迹洇开 */
    filter: blur(0.6px);
    animation-fill-mode: forwards;
  }

  /* 写完的字母去洇开 */
  @keyframes hw-write {
    0% {
      clip-path: polygon(100% 100%, 100% 100%, 0% 100%, 0% 100%);
      filter: blur(1.2px);
      opacity: 0.5;
    }
    30% {
      clip-path: polygon(100% 100%, 100% 60%, 40% 100%, 0% 100%);
      filter: blur(0.8px);
      opacity: 0.7;
    }
    70% {
      clip-path: polygon(100% 100%, 100% 20%, 80% 0%, 20% 100%, 0% 80%, 0% 0%);
      filter: blur(0.3px);
      opacity: 0.9;
    }
    100% {
      clip-path: polygon(100% 0%, 0% 0%, 0% 100%, 100% 100%);
      filter: blur(0);
      opacity: 1;
    }
  }

  /* 笔尖：每个字母写完后的收笔小点 */
  .handwrite__dot {
    position: absolute;
    top: 50%;
    right: -1px;
    width: 5px; height: 5px;
    margin-top: -2px;
    border-radius: 50%;
    background: radial-gradient(circle,
      var(--color-accent) 0%,
      color-mix(in srgb, var(--color-accent) 30%, transparent) 60%,
      transparent 80%
    );
    opacity: 0;
    animation: hw-dot-pulse 300ms ease-out forwards;
    animation-delay: calc(var(--hw-delay, 400ms) + var(--l-delay, 0ms) + var(--l-dur, 200ms) - 50ms);
    pointer-events: none;
  }

  @keyframes hw-dot-pulse {
    0%   { opacity: 0.9; transform: scale(1.6); }
    100% { opacity: 0;   transform: scale(0.3); }
  }

  @media (prefers-reduced-motion: reduce) {
    .handwrite__word { display: none; }
    .handwrite__fallback { display: block !important; }
    .handwrite__dot { display: none; }
  }
</style>