---
export interface Props {
  text: string;
  class?: string;
  delay?: number;
  as?: 'span' | 'h1' | 'h2' | 'p';
}

const { text, class: className, delay = 400, as: Tag = 'span' } = Astro.props;
const id = `hw-${Math.random().toString(36).slice(2, 8)}`;
---

<Tag
  class:list={['handwrite', className]}
  aria-label={text}
>
  <canvas class="handwrite__canvas" id={id} aria-hidden="true"></canvas>
  <span class="handwrite__fallback">{text}</span>
</Tag>

<style>
  .handwrite {
    display: block;
    position: relative;
    line-height: 1.2;
    min-height: 1.2em;
  }
  .handwrite__canvas {
    display: block;
    width: 100%;
    max-width: 380px;
    height: auto;
  }
  .handwrite__fallback {
    font-family: 'Caveat', 'Segoe Script', cursive;
    font-size: 2.2rem;
    font-weight: 500;
    color: var(--color-text);
  }
  .js .handwrite__fallback { display: none; }
  .no-js .handwrite__canvas { display: none; }

  /* 笔尖：JS 动态创建，跟随书写进度移动 */
  :global(.handwrite__nib) {
    position: fixed;
    width: 5px;
    height: 18px;
    margin-left: -2px;
    margin-top: -9px;
    pointer-events: none;
    z-index: 100;
    opacity: 0.8;
    border-radius: 50%;
    background: radial-gradient(
      ellipse 2px 60% at 50% 50%,
      var(--color-accent) 0%,
      color-mix(in srgb, var(--color-accent) 30%, transparent) 40%,
      transparent 70%
    );
    box-shadow: 0 0 4px color-mix(in srgb, var(--color-accent) 25%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .handwrite__canvas { display: none; }
    .handwrite__fallback { display: block !important; }
    :global(.handwrite__nib) { display: none !important; }
  }
</style>

<script>
  function setupHandwrite() {
    document.querySelectorAll('.handwrite__canvas').forEach((c) => init(c as HTMLCanvasElement));
  }

  function init(canvas: HTMLCanvasElement) {
    const label = canvas.closest('.handwrite')?.getAttribute('aria-label') ?? '';
    if (!label) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if ((canvas as any).__hwDone) return;
    (canvas as any).__hwDone = true;

    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const W = 640;
    const H = 110;
    canvas.width = W * dpr;
    canvas.height = H * dpr;
    canvas.style.width = '100%';
    canvas.style.height = 'auto';

    const ctx = canvas.getContext('2d')!;
    ctx.scale(dpr, dpr);

    const style = getComputedStyle(document.documentElement);
    const ink = style.getPropertyValue('--color-text').trim() || '#1a1814';
    const accent = style.getPropertyValue('--color-accent').trim() || '#ff5e00';

    // 离屏：完整文字
    const off = document.createElement('canvas');
    off.width = W; off.height = H;
    const octx = off.getContext('2d')!;
    octx.font = "500 52px 'Caveat', 'Segoe Script', cursive";
    octx.fillStyle = ink;
    octx.textBaseline = 'alphabetic';
    octx.fillText(label, 4, 66);

    ctx.font = "500 52px 'Caveat', 'Segoe Script', cursive";
    ctx.fillStyle = ink;
    ctx.textBaseline = 'alphabetic';

    // 预计算每列像素的高度信息
    const imgData = octx.getImageData(0, 0, W, H);
    const cols: { top: number; bot: number }[] = [];
    for (let x = 0; x < W; x++) {
      let top = H, bot = 0;
      for (let y = 0; y < H; y++) {
        const a = imgData.data[(y * W + x) * 4 + 3];
        if (a > 20) { if (y < top) top = y; if (y > bot) bot = y; }
      }
      cols.push({ top, bot: bot > top ? bot : top + 1 });
    }

    let col = 0;
    const startTime = performance.now();
    const DELAY = 400;
    const DURATION = 2400;

    // 笔尖：canvas 外的 DOM 元素
    const nib = document.createElement('span');
    nib.className = 'handwrite__nib';
    nib.setAttribute('aria-hidden', 'true');
    canvas.parentElement!.appendChild(nib);

    const canvasRect = () => canvas.getBoundingClientRect();

    function draw(now: number) {
      const elapsed = now - startTime;
      if (elapsed < DELAY) { requestAnimationFrame(draw); return; }

      const t = Math.min((elapsed - DELAY) / DURATION, 1);
      // 书写节奏：起笔蓄墨慢 → 中间匀速 → 快写完时微提笔加速
      const eased = t < 0.06 ? t * 0.4 :
                     t < 0.88 ? 0.024 + (t - 0.06) * 1.02 :
                     0.86 + (t - 0.88) * 1.8;
      const target = Math.min(Math.floor(W * eased), W - 1);
      if (target <= col) { requestAnimationFrame(draw); return; }

      // 逐列增量画出像素
      for (let x = col + 1; x <= target; x++) {
        const c = cols[x];
        if (c.bot <= c.top) continue;
        // 复制这一列的像素
        const sliceW = 1;
        ctx.drawImage(off, x, c.top, sliceW, c.bot - c.top, x, c.top, sliceW, c.bot - c.top);
      }

      // 最后一笔：墨迹微洇——复制笔尖附近几列时加轻微模糊
      if (target - col > 3 && target < W - 2) {
        // 刚画完的最后一列加微弱 blur（通过半透明重绘模拟墨洇）
        ctx.save();
        ctx.globalAlpha = 0.15;
        ctx.filter = 'blur(2px)';
        const bx = Math.max(0, target - 3);
        ctx.drawImage(off, bx, 0, 6, H, bx, 0, 6, H);
        ctx.filter = 'none';
        ctx.restore();
        // 重新画回清晰像素（只在洇开区域）
        for (let x = Math.max(0, target - 3); x <= target; x++) {
          const c = cols[x];
          if (c.bot <= c.top) continue;
          ctx.drawImage(off, x, c.top, 1, c.bot - c.top, x, c.top, 1, c.bot - c.top);
        }
      }

      col = target;

      // 更新笔尖位置
      const rect = canvasRect();
      const frac = col / W;
      const px = rect.left + rect.width * frac;
      const colData = cols[col];
      const midY = (colData.top + colData.bot) / 2;
      const py = rect.top + (midY / H) * rect.height;
      nib.style.left = px + 'px';
      nib.style.top = py + 'px';

      if (col >= W - 1) {
        // 写完，最终 fillText 保证干净
        ctx.clearRect(0, 0, W, H);
        ctx.fillText(label, 4, 66);
        nib.style.opacity = '0';
        nib.style.transition = 'opacity 0.3s ease';
        return;
      }

      requestAnimationFrame(draw);
    }

    requestAnimationFrame(draw);
  }

  if (document.fonts) {
    document.fonts.ready.then(() => setupHandwrite());
  } else {
    setTimeout(setupHandwrite, 600);
  }

  document.addEventListener('astro:page-load', () => {
    if (document.fonts) {
      document.fonts.ready.then(() => setupHandwrite());
    } else {
      setTimeout(setupHandwrite, 600);
    }
  });
</script>