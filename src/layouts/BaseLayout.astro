---
import { ClientRouter } from 'astro:transitions';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead title={title} description={description} />
    <ClientRouter />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      // View Transitions 切页时会用新页面的 html 属性覆盖旧属性（新页面 SSR 没有 data-theme），
      // 需要在 swap 前记住主题，swap 后恢复，避免闪回默认浅色。
      let _themeBeforeSwap = null;
      document.addEventListener('astro:before-swap', () => {
        _themeBeforeSwap = document.documentElement.getAttribute('data-theme');
      });
      document.addEventListener('astro:after-swap', () => {
        const root = document.documentElement;
        if (!root.hasAttribute('data-theme') && _themeBeforeSwap) {
          root.setAttribute('data-theme', _themeBeforeSwap);
        }
      });

      function setupReveal() {
        const els = document.querySelectorAll('[data-reveal]');
        if (!els.length) return;
        const prefersReduced = window.matchMedia(
          '(prefers-reduced-motion: reduce)',
        ).matches;
        if (prefersReduced || !('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
        );
        els.forEach((el) => io.observe(el));
      }

      function setupCopyButtons() {
        const blocks = document.querySelectorAll('pre.astro-code');
        blocks.forEach((pre) => {
          if (pre.querySelector('.astro-code__copy')) return;
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'astro-code__copy';
          btn.textContent = '复制';
          btn.setAttribute('aria-label', '复制代码');
          btn.addEventListener('click', async () => {
            const text = pre.innerText;
            try {
              await navigator.clipboard.writeText(text);
            } catch {
              /* clipboard 不可用时静默失败 */
              return;
            }
            btn.textContent = '已复制';
            btn.classList.add('astro-code__copy--done');
            window.setTimeout(() => {
              btn.textContent = '复制';
              btn.classList.remove('astro-code__copy--done');
            }, 1200);
          });
          pre.appendChild(btn);
        });
      }

      function onReady() {
        setupReveal();
        setupCopyButtons();
      }

      onReady();
      document.addEventListener('astro:page-load', onReady);
    </script>
  </body>
</html>
