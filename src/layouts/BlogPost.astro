---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Comments from '../components/Comments.astro';
import Typewriter from '../components/Typewriter.astro';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = entry.data;
---

<BaseLayout title={title} description={description}>
  <article class="post container">
    <header class="post__header">
      <Typewriter
        as="h1"
        class="post__title"
        phrases={[title]}
        typeSpeed={55}
        startDelay={250}
      />
      {
        description && (
          <p class="post__description text-soft">{description}</p>
        )
      }
      <div class="post__meta text-faint">
        <FormattedDate date={pubDate} />
        {
          updatedDate && (
            <>
              <span class="post__meta-sep">·</span>
              <span>更新于 <FormattedDate date={updatedDate} /></span>
            </>
          )
        }
      </div>
      {
        tags.length > 0 && (
          <ul class="post__tags">
            {tags.map((tag) => (
              <li class="post__tag">#{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="post__body">
      <slot />
    </div>

    <Comments />
  </article>
</BaseLayout>

<style>
  .post {
    padding-top: var(--space-4);
    padding-bottom: var(--space-5);
  }

  .post__header {
    margin-bottom: var(--space-4);
  }

  /* 标题用 Typewriter 渲染（display:inline），沿用 h1 排版 */
  .post__title {
    font-family: var(--font-sans);
    font-size: 1.9rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin: 0 0 0.75rem;
  }

  .post__description {
    font-size: 1.1rem;
    margin-bottom: 0.75rem;
  }

  .post__meta {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .post__meta-sep {
    opacity: 0.6;
  }

  .post__tags {
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .post__tag {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--color-text-faint);
  }

  .post__body :global(h2) {
    margin-top: var(--space-4);
  }

  @media (max-width: 640px) {
    .post__title {
      font-size: 1.6rem;
    }
  }
</style>
