---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { formatReadingTime } from '../../utils/reading';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<BaseLayout title="文章" description="所有文章列表">
  <section class="container">
    <header class="page-head">
      <h1 class="page-head__title">文章</h1>
      <p class="page-head__count text-faint">{posts.length} 篇</p>
    </header>

    {
      allTags.length > 0 && (
        <div class="tags">
          {allTags.map((tag) => (
            <a
              href={`/blog/tags/${encodeURIComponent(tag)}/`}
              class="tags__item"
            >
              #{tag}
            </a>
          ))}
        </div>
      )
    }

    <p class="tags__all">
      <a href="/blog/tags/" class="tags__all-link">全部标签 →</a>
    </p>

    <ul class="post-list">
      {
        posts.map((post, i) => (
          <li
            class="post-list__item"
            data-reveal
            style={`--reveal-delay: ${i * 70}`}
          >
            <a href={`/blog/${post.id}/`} class="post-list__link">
              <span class="post-list__date text-faint">
                <FormattedDate date={post.data.pubDate} />
                <span class="post-list__sep">·</span>
                {formatReadingTime(post.body ?? '')}
              </span>
              <span class="post-list__title">{post.data.title}</span>
              {post.data.description && (
                <span class="post-list__desc text-soft">
                  {post.data.description}
                </span>
              )}
            </a>
          </li>
        ))
      }
    </ul>

    {
      posts.length === 0 && <p class="text-soft">还没有文章。</p>
    }
  </section>
</BaseLayout>

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: var(--space-2);
  }

  .tags__item {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-text-soft);
    text-decoration: none;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .tags__item:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .tags__all {
    margin: 0 0 var(--space-3);
  }

  .tags__all-link {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--color-text-soft);
    text-decoration: none;
  }

  .tags__all-link:hover {
    color: var(--color-accent);
  }
</style>
