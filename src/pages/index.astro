---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Handwrite from '../components/Handwrite.astro';
import Typewriter from '../components/Typewriter.astro';
import { formatReadingTime } from '../utils/reading';
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  SOCIAL_LINKS,
} from '../consts';

const allPosts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const posts = allPosts.slice(0, 5);

// 热门标签：按文章数倒序，同数按标签名排，取前 8
const tagCounts = new Map<string, number>();
for (const post of allPosts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const topTags = [...tagCounts.entries()]
  .sort((a, b) => {
    if (b[1] !== a[1]) return b[1] - a[1];
    return a[0].localeCompare(b[0], 'zh-Hans-CN');
  })
  .slice(0, 8);

const recentDate = allPosts[0]?.data.pubDate;
---

<BaseLayout>
  <div class="home container-wide">
    <aside class="home__sidebar">
      <div class="sidebar-brand">
        <Handwrite
            text={SITE_TITLE}
            delay={400}
            as="h1"
            class="sidebar__title"
          />
        <p class="sidebar__tagline">
          <Typewriter
            phrases={[SITE_DESCRIPTION]}
            typeSpeed={70}
            startDelay={300}
          />
        </p>
      </div>

      {
        SOCIAL_LINKS.length > 0 && (
          <ul class="sidebar__links">
            {SOCIAL_LINKS.map((link) => (
              <li>
                <a href={link.href} class="sidebar__link" rel="me">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }

      {
        topTags.length > 0 && (
          <div class="sidebar-block">
            <h2 class="sidebar__heading">标签</h2>
            <ul class="sidebar__tags">
              {topTags.map(([tag, count]) => (
                <li>
                  <a
                    href={`/blog/tags/${encodeURIComponent(tag)}/`}
                    class="sidebar__tag"
                  >
                    <span class="sidebar__tag-name">#{tag}</span>
                    <span class="sidebar__tag-count">{count}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <div class="sidebar-block">
        <h2 class="sidebar__heading">站点</h2>
        <dl class="sidebar__stats">
          <div>
            <dt>文章</dt>
            <dd>{allPosts.length}</dd>
          </div>
          {
            recentDate && (
              <div>
                <dt>最近更新</dt>
                <dd><FormattedDate date={recentDate} /></dd>
              </div>
            )
          }
        </dl>
      </div>
    </aside>

    <section class="home__main">
      <div class="main-head">
        <h2 class="main-head__title">最近</h2>
        <a href="/blog" class="main-head__link">全部 →</a>
      </div>

      <ul class="post-list">
        {
          posts.map((post, i) => (
            <li
              class="post-list__item"
              data-reveal
              style={`--reveal-delay: ${i * 70}`}
            >
              <a href={`/blog/${post.id}/`} class="post-list__link">
                <span class="post-list__date text-faint">
                  <FormattedDate date={post.data.pubDate} />
                  <span class="post-list__sep">·</span>
                  {formatReadingTime(post.body ?? '')}
                </span>
                <span class="post-list__title">{post.data.title}</span>
                {post.data.description && (
                  <span class="post-list__desc text-soft">
                    {post.data.description}
                  </span>
                )}
              </a>
            </li>
          ))
        }
      </ul>

      {
        posts.length === 0 && <p class="text-soft">还没有文章。</p>
      }
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: var(--space-5);
    padding-top: var(--space-4);
    padding-bottom: var(--space-3);
    align-items: start;
  }

  .home__main {
    border-left: 1px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
    padding-left: var(--space-4);
  }

  /* 时间轴 */
  .home__main .post-list__date {
    position: relative;
  }

  .home__main .post-list__date::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--space-4));
    top: 50%;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-bg);
    border: 2px solid color-mix(in srgb, var(--color-accent) 70%, transparent);
    transform: translate(-50%, -50%);
    transition:
      background 0.2s ease,
      border-color 0.2s ease;
    z-index: 1;
  }

  .home__main .post-list__date::after {
    content: '';
    position: absolute;
    left: calc(-1 * var(--space-4));
    top: 50%;
    width: calc(var(--space-4) - 0.6rem);
    height: 1px;
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--color-accent) 35%, transparent),
      transparent
    );
    transform: translateY(-50%);
  }

  .home__main .post-list__item:hover .post-list__date::before {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  /* ---- 侧栏 ---- */
  .home__sidebar {
    position: sticky;
    top: 5rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: 0.5rem;
  }

  /* 品牌区：大标题 + 标语 */
  .sidebar-brand {
    padding-bottom: var(--space-2);
  }

  :global(.sidebar__title) {
    font-family: 'Caveat', 'Segoe Script', cursive;
    font-size: 2.2rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    margin: 0 0 0.4rem;
    line-height: 1.2;
  }

  :global(.sidebar__title)::after {
    content: '';
    display: block;
    width: 2rem;
    height: 3px;
    background: var(--color-accent);
    margin-top: 0.65rem;
    border-radius: 2px;
  }

  .sidebar__tagline {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--color-text-soft);
    margin: 0;
    line-height: 1.65;
    min-height: 1.65em;
  }

  /* 社交链接 */
  .sidebar__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .sidebar__link {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    text-decoration: none;
    color: var(--color-text-soft);
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background 0.15s ease;
  }

  .sidebar__link::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-text-faint);
    transition: background 0.15s ease;
  }

  .sidebar__link:hover {
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 40%, transparent);
    background: color-mix(in srgb, var(--color-accent) 6%, transparent);
  }

  .sidebar__link:hover::before {
    background: var(--color-accent);
  }

  /* 分区标题 */
  .sidebar__heading {
    font-family: 'Caveat', 'Segoe Script', cursive;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-text-faint);
    margin: 0 0 0.6rem;
    text-transform: none;
  }

  .sidebar-block {
    padding-bottom: var(--space-2);
  }

  .sidebar-block + .sidebar-block {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-3);
  }

  /* 标签 */
  .sidebar__tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .sidebar__tag {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    text-decoration: none;
    color: var(--color-text-soft);
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    padding: 0.25rem 0.65rem;
    background: var(--color-bg-soft);
    border-radius: 5px;
    transition:
      color 0.15s ease,
      background 0.15s ease,
      transform 0.15s ease;
  }

  .sidebar__tag:hover {
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 10%, var(--color-bg-soft));
    transform: translateY(-1px);
  }

  .sidebar__tag-count {
    font-size: 0.7rem;
    color: var(--color-text-faint);
    font-weight: 500;
  }

  /* 统计 */
  .sidebar__stats {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .sidebar__stats > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .sidebar__stats dt {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    margin: 0;
    color: var(--color-text-soft);
  }

  .sidebar__stats dd {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    margin: 0;
    color: var(--color-text);
  }

  .main-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.5rem;
  }

  .main-head__title {
    font-size: 1rem;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-soft);
  }

  .main-head__link {
    font-family: var(--font-sans);
    font-size: 0.88rem;
    text-decoration: none;
    color: var(--color-text-soft);
  }

  .main-head__link:hover {
    color: var(--color-accent);
  }

  @media (max-width: 860px) {
    .home {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
    .home__sidebar {
      position: static;
    }
    .home__main {
      border-left: none;
      padding-left: 0;
    }
    :global(.sidebar__title) {
      font-size: 1.8rem;
    }
    :global(.sidebar__title)::after {
      margin-top: 0.5rem;
    }
  }
</style>
