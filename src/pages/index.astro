---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Typewriter from '../components/Typewriter.astro';
import {
  SITE_TITLE,
  SITE_DESCRIPTION,
  SOCIAL_LINKS,
} from '../consts';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<BaseLayout>
  <div class="home container-wide">
    <aside class="home__sidebar">
      <div class="sidebar-block">
        <h1 class="sidebar__title">{SITE_TITLE}</h1>
        <p class="sidebar__tagline">
          <Typewriter
            phrases={[SITE_DESCRIPTION]}
            typeSpeed={70}
            startDelay={300}
          />
        </p>

        {
          SOCIAL_LINKS.length > 0 && (
            <ul class="sidebar__links">
              {SOCIAL_LINKS.map((link) => (
                <li>
                  <a href={link.href} class="sidebar__link" rel="me">
                    {link.label} ↗
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </aside>

    <section class="home__main">
      <div class="main-head">
        <h2 class="main-head__title">最近</h2>
        <a href="/blog" class="main-head__link">全部 →</a>
      </div>

      <ul class="post-list">
        {
          posts.map((post, i) => (
            <li
              class="post-list__item"
              data-reveal
              style={`--reveal-delay: ${i * 70}`}
            >
              <a href={`/blog/${post.id}/`} class="post-list__link">
                <div class="post-list__main">
                  <span class="post-list__title">{post.data.title}</span>
                  {post.data.description && (
                    <span class="post-list__desc text-soft">
                      {post.data.description}
                    </span>
                  )}
                </div>
                <span class="post-list__date text-faint">
                  <FormattedDate date={post.data.pubDate} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      {
        posts.length === 0 && <p class="text-soft">还没有文章。</p>
      }
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: var(--space-5);
    padding-top: var(--space-4);
    padding-bottom: var(--space-3);
    align-items: start;
  }

  .home__sidebar {
    position: sticky;
    top: 5rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .sidebar-block {
    padding-bottom: var(--space-2);
  }

  .sidebar-block + .sidebar-block {
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-2);
  }

  .sidebar__title {
    font-family: var(--font-sans);
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0 0 0.5rem;
  }

  .sidebar__tagline {
    font-family: var(--font-sans);
    font-size: 0.92rem;
    color: var(--color-text-soft);
    margin: 0;
    line-height: 1.6;
    min-height: 1.6em;
  }

  .sidebar__links {
    list-style: none;
    padding: 0;
    margin: var(--space-2) 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .sidebar__link {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--color-text-soft);
  }

  .sidebar__link:hover {
    color: var(--color-accent);
  }

  .main-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.5rem;
  }

  .main-head__title {
    font-size: 1rem;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-soft);
  }

  .main-head__link {
    font-family: var(--font-sans);
    font-size: 0.88rem;
    text-decoration: none;
    color: var(--color-text-soft);
  }

  .main-head__link:hover {
    color: var(--color-accent);
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .post-list__item {
    border-bottom: 1px solid var(--color-border);
  }

  .post-list__link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 0;
    text-decoration: none;
  }

  .post-list__main {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .post-list__title {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 500;
  }

  .post-list__link:hover .post-list__title {
    color: var(--color-accent);
  }

  .post-list__desc {
    font-size: 0.9rem;
  }

  .post-list__date {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    white-space: nowrap;
    flex-shrink: 0;
  }

  @media (max-width: 860px) {
    .home {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
    .home__sidebar {
      position: static;
    }
  }

  @media (max-width: 480px) {
    .post-list__link {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.3rem;
    }
  }
</style>
