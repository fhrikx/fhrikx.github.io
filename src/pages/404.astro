---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { formatReadingTime } from '../utils/reading';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<BaseLayout title="未找到" description="页面不存在">
  <section class="container not-found">
    <p class="not-found__code">404</p>
    <p class="text-soft">这里什么也没有。</p>
    <p>
      <a href="/">← 回到首页</a>
    </p>

    {posts.length > 0 && (
      <div class="not-found__recent">
        <p class="not-found__heading">最近的文章</p>
        <ul class="post-list">
          {posts.map((post) => (
            <li class="post-list__item">
              <a href={`/blog/${post.id}/`} class="post-list__link">
                <span class="post-list__date text-faint">
                  <FormattedDate date={post.data.pubDate} />
                  <span class="post-list__sep">·</span>
                  {formatReadingTime(post.body ?? '')}
                </span>
                <span class="post-list__title">{post.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-top: var(--space-5);
    text-align: center;
  }

  .not-found__code {
    font-family: var(--font-sans);
    font-size: 4rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
    color: var(--color-text-faint);
    /* 手绘大数字：像笔记本上随手划的页码 */
    opacity: 0.35;
    letter-spacing: 0.06em;
    user-select: none;
  }

  .not-found__recent {
    margin: var(--space-5) auto 0;
    max-width: 540px;
    text-align: left;
  }

  .not-found__heading {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-faint);
    margin: 0 0 var(--space-2);
  }
</style>
